# -----------------------------------------------------------------------------
# PostgreSQL - substitua a senha e mantenha DATABASE_URL sincronizada
# -----------------------------------------------------------------------------
POSTGRES_DB=controlecc
POSTGRES_USER=controlecc
POSTGRES_PASSWORD=troque-por-uma-senha-longa
DATABASE_URL=postgresql://controlecc:troque-por-uma-senha-longa@postgres:5432/controlecc
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Aplicação e Auth.js - gere NEXTAUTH_SECRET com pelo menos 32 bytes
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=troque-por-um-nome-de-projeto-docker
NEXTAUTH_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-bytes
NEXTAUTH_URL=http://127.0.0.1
APP_URL=http://127.0.0.1

# -----------------------------------------------------------------------------
# Caddy - HTTP local; informe domínios HTTPS reais em produção
# -----------------------------------------------------------------------------
CADDY_APP_ADDRESS=http://127.0.0.1
CADDY_STORAGE_ADDRESS=http://127.0.0.1:9000
APP_HTTP_PORT=80
APP_HTTPS_PORT=443
STORAGE_HTTP_PORT=9000

# -----------------------------------------------------------------------------
# MinIO/S3 - nunca exponha S3_SECRET_KEY ao navegador
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=certificados
S3_ACCESS_KEY=troque-por-um-usuario-minio
S3_SECRET_KEY=troque-por-uma-senha-longa-do-minio

# -----------------------------------------------------------------------------
# SMTP - configuração abaixo usa Mailpit no desenvolvimento
# Em produção, informe host, TLS e credenciais do SMTP institucional
# -----------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=ControleCC <no-reply@localhost>
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Backups - configure retenção e periodicidade conforme a instituição
# -----------------------------------------------------------------------------
POSTGRES_BACKUP_SCHEDULE=0 2 * * *
POSTGRES_BACKUP_KEEP_DAYS=7
POSTGRES_BACKUP_KEEP_WEEKS=4
POSTGRES_BACKUP_KEEP_MONTHS=6
MINIO_BACKUP_INTERVAL_SECONDS=86400

# -----------------------------------------------------------------------------
# reCAPTCHA v2 - chaves oficiais de teste; substitua em produção
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
